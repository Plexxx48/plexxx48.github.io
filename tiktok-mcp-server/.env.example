# URL publique HTTPS où le serveur est hébergé (sans / final)
PUBLIC_URL=https://votre-serveur.example.com
PORT=3000

# Identifiants de votre application TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Scopes demandés (doivent être activés dans votre app TikTok)
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.publish,video.upload

# Chaîne aléatoire d'au moins 32 caractères pour chiffrer les jetons TikTok
# Générer avec : openssl rand -base64 48
TOKEN_ENCRYPTION_SECRET=

# Fichier de stockage (mettez-le sur un volume persistant)
DATA_FILE=./data/store.json

# Optionnel : n'autoriser que certains comptes TikTok (open_id séparés par des virgules)
ALLOWED_TIKTOK_OPEN_IDS=

# Optionnel
ACCESS_TOKEN_TTL_SEC=3600
MAX_VIDEO_MB=1024
